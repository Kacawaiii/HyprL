# Copy to private runtime configuration; never commit a populated file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://hyprlcore.com
TRUST_PROXY=true
DATA_FILE=data/subscribers.json
ADMIN_PASSWORD=
# Operator address: environment only, no default in code.
NOTIFY_EMAIL=REPLACE_WITH_PRIVATE_NOTIFICATION_ADDRESS
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Enable only after EU location, DPA and published processor identity are verified.
SMTP_EU_APPROVED=false

# Member workspace: disabled until operator setup and acceptance. Secrets env only.
MEMBER_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ROLE_EARLY=
DISCORD_ROLE_ESSENTIEL=
DISCORD_ROLE_PREMIUM=
DISCORD_ROLE_FONDATEUR=
DISCORD_ROLE_EQUIPE=
# Exactly 32 random bytes encoded as 64 lowercase hex characters. Keep stable.
MEMBER_IDENTITY_KEY=
# Absolute dedicated runtime paths outside every source/code release.
MEMBER_STATE_FILE=
MEMBER_SNAPSHOT_DIR=
MEMBER_ROUTER_SOCKET=
# Separate 32-byte hex secret, shared with the local bridge, never with browsers.
MEMBER_ROUTER_KEY=
# Exact HTTPS origin of the future provider's member portal; empty until connected.
MEMBER_BILLING_ORIGIN=
# Optional free newsletter. Private keys must be independent random 32-byte hex values.
NEWSLETTER_ENABLED=false
NEWSLETTER_TOKEN_KEY=
NEWSLETTER_WORKER_KEY=
# Set true only after disabling and checking Brevo open/click tracking.
NEWSLETTER_TRACKING_DISABLED=false
# Read-only sanitized v2 member snapshot directory (defaults to MEMBER_SNAPSHOT_DIR).
PUBLIC_SNAPSHOT_DIR=
