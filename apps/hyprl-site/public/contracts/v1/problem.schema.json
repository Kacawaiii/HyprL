{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprlcore.com/contracts/v1/problem.schema.json",
  "title": "RFC 9457 problem details",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "detail"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string",
      "format": "uri-reference"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
