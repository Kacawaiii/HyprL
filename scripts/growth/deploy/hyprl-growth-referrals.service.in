[Unit]
Description=HyprL dedicated referral service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@GROWTH_RELEASE@
EnvironmentFile=@DISCORD_ENV@
EnvironmentFile=%h/.config/hyprl-growth/referral.env
ExecCondition=@PYTHON@ -c "import os,sys; sys.exit(0 if os.environ.get('REFERRAL_ENABLED') == 'true' else 1)"
ExecStart=@PYTHON@ -m scripts.growth.discord_bot
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=160M
CPUQuota=20%

[Install]
WantedBy=default.target
