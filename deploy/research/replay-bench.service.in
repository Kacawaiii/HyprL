[Unit]
Description=HyprL Opus research replay bench (60 calls per night)

[Service]
Type=exec
WorkingDirectory=@WORKTREE@
EnvironmentFile=@ENVIRONMENT@
Environment=PATH=@CLI_PATH@:/usr/bin:/bin
ExecStart=@PYTHON@ -m scripts.trading_lab.replay_bench.cli night --expected-commit @COMMIT@
UMask=0077
NoNewPrivileges=yes
Nice=15
CPUQuota=50%
MemoryMax=700M
RuntimeMaxSec=18000
TimeoutStopSec=20
KillMode=control-group
Restart=no
SuccessExitStatus=2
